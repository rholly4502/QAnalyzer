<Window x:Class="QAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QAnalyzer — Static T-SQL Analyzer" Height="680" Width="1020"
        MinHeight="420" MinWidth="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="ThemeToggle" DockPanel.Dock="Right" Content="Tema: Gelap"
                    Width="110" Height="30" Margin="8,0,0,0" Click="OnToggleThemeClick"/>
            <Button DockPanel.Dock="Left" Content="Buka .sql…" Width="100" Height="30" Click="OnOpenFileClick"/>
            <ComboBox x:Name="ProfileCombo" DockPanel.Dock="Left" Width="130" Margin="8,0,0,0"
                      Height="30" SelectionChanged="OnProfileChanged">
                <ComboBoxItem Content="General" IsSelected="True"/>
                <ComboBoxItem Content="Reporting"/>
            </ComboBox>
            <CheckBox x:Name="MaxDopCheck" Content="Hemat resource (MAXDOP 1)" DockPanel.Dock="Left"
                      Margin="12,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Script T-SQL" FontWeight="SemiBold" Margin="0,0,0,6"
                   VerticalAlignment="Top"/>
        <TextBox x:Name="ScriptEditor" Grid.Row="1" Margin="0,22,0,0"
                 AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Padding="6"
                 Background="{DynamicResource EditableBackgroundBrush}"
                 Foreground="{DynamicResource EditableForegroundBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Analisis" Width="110" Height="30" Click="OnAnalyzeClick" FontWeight="SemiBold"/>
            <Button x:Name="CheckPlanButton" Content="Cek Plan (Server)" Width="125" Height="30" Margin="8,0,0,0" Click="OnCheckPlanClick"/>
            <Button Content="Salin Laporan MD" Width="130" Height="30" Margin="8,0,0,0" Click="OnCopyMarkdownClick"/>
            <Button Content="Export MD…" Width="100" Height="30" Margin="8,0,0,0" Click="OnExportMarkdownClick"/>
            <Button Content="Export CSV…" Width="100" Height="30" Margin="8,0,0,0" Click="OnExportCsvClick"/>
            <Button Content="Tuning" Width="90" Height="30" Margin="8,0,0,0" Click="OnTuningClick" FontWeight="SemiBold"/>
            <TextBlock x:Name="TuningStatus" Margin="12,6,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}"/>
            <TextBlock x:Name="StatusText" Margin="12,6,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryMutedForegroundBrush}"/>
        </StackPanel>

        <!-- dashboard + filter -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                <CheckBox x:Name="FilterCritical" Content="Critical" IsChecked="True" Margin="8,0,0,0"
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Foreground="{DynamicResource Level.CriticalForeground}"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="FilterWarning" Content="Warning" IsChecked="True" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Level.WarningForeground}"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                <CheckBox x:Name="FilterInfo" Content="Info" IsChecked="True" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Level.InfoForeground}"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Background="{DynamicResource Level.CriticalBackground}" CornerRadius="4" Padding="10,3" Margin="0,0,6,0">
                    <TextBlock x:Name="DashCritical" FontWeight="SemiBold"
                               Foreground="{DynamicResource Level.CriticalForeground}"/>
                </Border>
                <Border Background="{DynamicResource Level.WarningBackground}" CornerRadius="4" Padding="10,3" Margin="0,0,6,0">
                    <TextBlock x:Name="DashWarning" FontWeight="SemiBold"
                               Foreground="{DynamicResource Level.WarningForeground}"/>
                </Border>
                <Border Background="{DynamicResource Level.InfoBackground}" CornerRadius="4" Padding="10,3">
                    <TextBlock x:Name="DashInfo" FontWeight="SemiBold"
                               Foreground="{DynamicResource Level.InfoForeground}"/>
                </Border>
            </StackPanel>
        </Grid>

        <TextBox x:Name="TuningOutput" Grid.Row="4" Margin="0,8,0,0"
                 AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True"
                 Visibility="Collapsed"
                 Background="{DynamicResource EditableBackgroundBrush}"
                 Foreground="{DynamicResource EditableForegroundBrush}"/>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ResultsGrid" Grid.Column="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      RowHeight="26" CanUserResizeRows="False" SelectionMode="Single"
                      SelectionChanged="OnResultSelected"
                      Background="{DynamicResource EditableBackgroundBrush}"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      RowBackground="{DynamicResource EditableBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource PanelBackgroundBrush}"
                      HorizontalGridLinesBrush="{DynamicResource SubtleBorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource SubtleBorderBrush}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                    <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="110"/>
                    <DataGridTextColumn Header="Baris" Binding="{Binding Line}" Width="50"/>
                    <DataGridTextColumn Header="Pesan" Binding="{Binding Message}" Width="380"/>
                    <DataGridTextColumn Header="Saran" Binding="{Binding Suggestion}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Width="320" Margin="8,0,0,0" Padding="8"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource PanelBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Detail" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DetailText" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Text="Pilih baris di daftar untuk melihat detail saran."
                             Background="{DynamicResource EditableBackgroundBrush}"
                             Foreground="{DynamicResource EditableForegroundBrush}"/>
                </StackPanel>
            </Border>
        <TextBlock Grid.Row="5" Margin="0,8,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}">
            <Run Text="ρ " FontFamily="Georgia" FontStyle="Italic" FontSize="14"
                 Foreground="{DynamicResource SecondaryMutedForegroundBrush}"/>
            <Run Text="RHO" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource SecondaryMutedForegroundBrush}"/>
            <Run Text=" · Rholly Kurnia Putra"/>
        </TextBlock>
        </Grid>
    </Grid>
</Window>
