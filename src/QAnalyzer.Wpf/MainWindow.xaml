<Window x:Class="QAnalyzer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QAnalyzer — Static T-SQL Analyzer" Height="680" Width="1020"
        MinHeight="420" MinWidth="640">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="Buka .sql…" Width="100" Height="30" Click="OnOpenFileClick"/>
            <ComboBox x:Name="ProfileCombo" DockPanel.Dock="Left" Width="130" Margin="8,0,0,0"
                      Height="30" SelectionChanged="OnProfileChanged">
                <ComboBoxItem Content="General" IsSelected="True"/>
                <ComboBoxItem Content="Reporting"/>
            </ComboBox>
            <CheckBox x:Name="MaxDopCheck" Content="Hemat resource (MAXDOP 1)" DockPanel.Dock="Left"
                      Margin="12,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="Script T-SQL" FontWeight="SemiBold" Margin="0,0,0,6"
                   VerticalAlignment="Top"/>
        <TextBox x:Name="ScriptEditor" Grid.Row="1" Margin="0,22,0,0"
                 AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Padding="6"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button Content="Analisis" Width="110" Height="30" Click="OnAnalyzeClick" FontWeight="SemiBold"/>
            <Button Content="Salin Laporan MD" Width="130" Height="30" Margin="8,0,0,0" Click="OnCopyMarkdownClick"/>
            <Button Content="Tuning" Width="90" Height="30" Margin="8,0,0,0" Click="OnTuningClick" FontWeight="SemiBold"/>
            <TextBlock x:Name="TuningStatus" Margin="12,6,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
            <TextBlock x:Name="StatusText" Margin="12,6,0,0" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <TextBox x:Name="TuningOutput" Grid.Row="3" Margin="0,8,0,0"
                 AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True"
                 Visibility="Collapsed"/>
        <DataGrid x:Name="ResultsGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  RowHeight="26" CanUserResizeRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="110"/>
                <DataGridTextColumn Header="Baris" Binding="{Binding Line}" Width="50"/>
                <DataGridTextColumn Header="Pesan" Binding="{Binding Message}" Width="380"/>
                <DataGridTextColumn Header="Saran" Binding="{Binding Suggestion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
