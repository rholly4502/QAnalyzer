<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SecondaryMutedForegroundBrush" Color="#7A7A7A"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="EditableBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="EditableForegroundBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Level.CriticalBackground" Color="#4A1F22"/>
    <SolidColorBrush x:Key="Level.CriticalForeground" Color="#FF8A87"/>
    <SolidColorBrush x:Key="Level.WarningBackground" Color="#4A3A12"/>
    <SolidColorBrush x:Key="Level.WarningForeground" Color="#E0B45C"/>
    <SolidColorBrush x:Key="Level.InfoBackground" Color="#1C344A"/>
    <SolidColorBrush x:Key="Level.InfoForeground" Color="#6FB7E8"/>
</ResourceDictionary>
