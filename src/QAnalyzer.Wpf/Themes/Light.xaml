<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#696969"/>
    <SolidColorBrush x:Key="SecondaryMutedForegroundBrush" Color="#808080"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#DDDDDD"/>
    <SolidColorBrush x:Key="EditableBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="EditableForegroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Level.CriticalBackground" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="Level.CriticalForeground" Color="#C0392B"/>
    <SolidColorBrush x:Key="Level.WarningBackground" Color="#FFF3DC"/>
    <SolidColorBrush x:Key="Level.WarningForeground" Color="#B9770E"/>
    <SolidColorBrush x:Key="Level.InfoBackground" Color="#EAF4FE"/>
    <SolidColorBrush x:Key="Level.InfoForeground" Color="#2471A3"/>
</ResourceDictionary>
